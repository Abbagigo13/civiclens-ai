# Copy to .env for local development and fill in your own values.
# Never commit .env. On Render, set these in the service's
# Environment settings instead — secrets never go in Git.

# Meta Model API key, server-side only. Optional: without it the app
# still works and visitors file reports manually.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3

# CORS allow-list (comma-separated). Local dev only; on Render the
# frontend and API share one origin so this is not exercised, but
# setting it to the Render URL is harmless.
CLIENT_ORIGIN=http://localhost:5173

# Port the Express server listens on. Render sets PORT itself;
# leave unset there.
PORT=3001

# SQLite report database and photo storage. Local defaults below.
# Production (Render/Docker) uses /data/civiclens.db and
# /data/photos on a Persistent Disk — see render.yaml.
REPORTS_DB_PATH=data/civiclens.db
REPORTS_PHOTO_DIR=data/photos

# Frontend API origin (Vite, build-time). Leave UNSET on Render:
# the app then uses same-origin relative /api requests. Only set
# this for a split frontend/backend deployment.
# VITE_API_BASE_URL=

# Access is open by design: anyone can file, browse and update
# reports without a key. No operator API key is required.

# Moderator key: when set, hiding and deleting reports requires
# this key (sent from Settings > Moderator key). Flagging, filing
# and confirming stay open. Leave unset for local development.
MODERATOR_KEY=
