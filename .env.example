# Copy to .env and fill in your own values. Never commit .env.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
CLIENT_ORIGIN=http://localhost:5173
PORT=3001
# Optional: SQLite file for report persistence (default: data/civiclens.db).
REPORTS_DB_PATH=data/civiclens.db
# Optional: report photo directory (default: photos/ next to the database).
REPORTS_PHOTO_DIR=data/photos
# Shared operator key for write endpoints (analyze, create, update, delete).
# When empty, writes are open (local development) with a startup warning.
API_KEY=
