# Copy to .env and fill in your own values. Never commit .env.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
CLIENT_ORIGIN=http://localhost:5173
# Comma-separated list allowed, e.g. production + custom domain:
# CLIENT_ORIGIN=https://your-app.vercel.app,https://example.com
# Frontend only (Vercel): Railway API origin, no trailing slash, no /api suffix.
# VITE_API_BASE_URL=https://your-api.up.railway.app
PORT=3001
# Optional: SQLite file for report persistence (default: data/civiclens.db).
REPORTS_DB_PATH=data/civiclens.db
# Optional: report photo directory (default: photos/ next to the database).
REPORTS_PHOTO_DIR=data/photos
# Access is open by design: anyone can file, browse and update
# reports without a key. No operator API key is required.
